---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', p => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const latestPost = posts[0];
const latestProject = projects[0];
---
<Base title="devhub — dự án, blog và công cụ của một dev" wide>
  <div class="container">
    <!-- Hero -->
    <section class="hero">
      <div>
        <h1>Dự án, bài viết và công cụ của một lập trình viên.</h1>
        <p class="lead">Mọi thứ mình làm và học được, gom về một nơi. Web tự cập nhật mỗi khi mình đẩy code lên GitHub.</p>
        <div class="cta-row">
          <a class="btn primary" href="/projects/">Xem dự án</a>
          <a class="btn ghost" href="/blog/">Đọc blog</a>
        </div>
      </div>
      <aside class="card hero-card" aria-label="Mới cập nhật">
        <div class="head">Mới cập nhật</div>
        {latestProject && (
          <a class="row" href="/projects/">
            <span class="kind">Dự án</span>
            <strong>{latestProject.data.title}</strong>
            <span class="meta">{latestProject.data.description}</span>
          </a>
        )}
        {latestPost && (
          <a class="row" href={`/blog/${latestPost.slug}/`}>
            <span class="kind">Bài viết</span>
            <strong>{latestPost.data.title}</strong>
            <span class="meta">{latestPost.data.date.toLocaleDateString('vi-VN')}</span>
          </a>
        )}
      </aside>
    </section>

    <!-- Nội dung chính -->
    <section class="block">
      <h2>Có gì ở đây</h2>
      <p class="sub">Ba phần chính, mỗi phần là một file Markdown bạn có thể sửa bất cứ lúc nào.</p>
      <div class="grid3">
        <a class="card feature" href="/projects/">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/></svg>
          <h3>Dự án</h3>
          <p>Các sản phẩm và thử nghiệm, kèm công nghệ dùng và mã nguồn.</p>
        </a>
        <a class="card feature" href="/blog/">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h11l3 3v13H5zM9 11h6M9 15h6"/></svg>
          <h3>Blog</h3>
          <p>Ghi chú kỹ thuật, kể cả bài được chuyển thẳng từ notebook Colab.</p>
        </a>
        <a class="card feature" href="/contact/">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4zM4 7l8 6 8-6"/></svg>
          <h3>Liên hệ</h3>
          <p>Gửi tin nhắn qua form, không cần đăng nhập hay tạo tài khoản.</p>
        </a>
      </div>
    </section>

    <!-- Quy trình (đây là một chuỗi bước nên đánh số) -->
    <section class="block">
      <h2>Web này vận hành thế nào</h2>
      <p class="sub">Từ lúc viết đến lúc xuất hiện trên mạng chỉ mất vài phút.</p>
      <ol class="steps">
        <li class="card"><h3>Viết</h3><p>Soạn bài bằng Markdown hoặc chạy notebook trên Colab.</p></li>
        <li class="card"><h3>Đẩy lên GitHub</h3><p>Mã nguồn và nội dung nằm trong một repo.</p></li>
        <li class="card"><h3>Tự deploy</h3><p>Cloudflare nhận thay đổi, build và đăng lên mạng.</p></li>
      </ol>
    </section>

    <!-- Mới nhất -->
    <section class="block">
      <div class="two">
        <div>
          <h3>Dự án</h3>
          <ul class="list">
            {projects.slice(0, 3).map(p => (
              <li><a class="title" href="/projects/">{p.data.title}</a><div class="meta">{p.data.description}</div></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Bài viết mới</h3>
          <ul class="list">
            {posts.slice(0, 3).map(p => (
              <li><a class="title" href={`/blog/${p.slug}/`}>{p.data.title}</a>
                <div class="meta">{p.data.date.toLocaleDateString('vi-VN')}</div></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Hỏi đáp -->
    <section class="block">
      <h2>Câu hỏi thường gặp</h2>
      <div class="faq">
        <details><summary>Web này làm bằng gì?</summary>
          <p>Astro tạo trang tĩnh, Cloudflare lưu trữ và phân phối, Formspree nhận tin nhắn từ form liên hệ.</p></details>
        <details><summary>Viết bài mới bằng cách nào?</summary>
          <p>Thêm một file Markdown vào thư mục blog, hoặc lưu notebook Colab vào thư mục notebooks trên GitHub.</p></details>
        <details><summary>Liên hệ bằng cách nào?</summary>
          <p>Dùng form ở trang Liên hệ. Tin nhắn được gửi thẳng tới email của mình.</p></details>
      </div>
    </section>

    <!-- Kêu gọi hành động -->
    <section class="block" style="border-top:0">
      <div class="banner">
        <h2>Có việc cần trao đổi?</h2>
        <p>Gửi tin nhắn, mình sẽ phản hồi sớm.</p>
        <a class="btn primary" href="/contact/">Gửi tin nhắn</a>
      </div>
    </section>
  </div>
</Base>
