---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', p => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="devhub — dự án, blog và công cụ của một dev" wide>
  <div class="container">
    <section class="hero">
      <h1>Cho mọi thứ mình xây.</h1>
      <p class="lead">Dự án, blog và công cụ gom về một nơi, tự cập nhật mỗi khi mình đẩy code.</p>
      <p class="cmd" aria-label="Lệnh minh họa: git push"><span class="prompt">&gt;</span>git push</p>
      <a class="pill" href="/tools/qr/"><span class="tag">MỚI</span> Công cụ tạo mã QR <span class="chev" aria-hidden="true">›</span></a>
      <div class="hero-links">
        <a href="/projects/">Xem dự án</a>
        <a href="/blog/">Đọc blog</a>
        <a href="/contact/">Liên hệ</a>
      </div>
    </section>

    <section class="tech" aria-label="Công nghệ sử dụng">
      <p class="micro">Xây dựng bằng</p>
      <ul class="wordmarks">
        <li>Astro</li><li>Cloudflare</li><li>GitHub</li><li>Colab</li><li>Formspree</li>
      </ul>
    </section>

    <figure class="codewin">
      <figcaption><span class="dots3" aria-hidden="true"><i></i><i></i><i></i></span><span class="fname">bai-moi.md</span><span></span></figcaption>
      <pre><code><span class="c">&#45;&#45;&#45;</span>
<span class="k">title</span>: <span class="s">"Bài viết mới"</span>
<span class="k">description</span>: <span class="s">"Một dòng mô tả ngắn"</span>
<span class="k">date</span>: <span class="n">2026-11-01</span>
<span class="k">tags</span>: [<span class="s">"colab"</span>]
<span class="c">&#45;&#45;&#45;</span></code></pre>
    </figure>

    <section class="block">
      <div class="two">
        <div>
          <h3>Dự án</h3>
          <ul class="list">
            {projects.slice(0, 3).map(p => (
              <li><a class="title" href="/projects/">{p.data.title}</a><div class="meta">{p.data.description}</div></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Bài viết mới</h3>
          <ul class="list">
            {posts.slice(0, 3).map(p => (
              <li><a class="title" href={`/blog/${p.slug}/`}>{p.data.title}</a>
                <div class="meta">{p.data.date.toLocaleDateString('vi-VN')}</div></li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </div>
</Base>
