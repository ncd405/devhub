---
import '../styles/global.css';
interface Props { title: string; description?: string; }
const { title, description = 'Công cụ, dự án và blog của một lập trình viên.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [['/', 'Trang chủ'], ['/projects/', 'Dự án'], ['/blog/', 'Blog'], ['/contact/', 'Liên hệ']];
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <!-- Áp dụng theme trước khi vẽ trang để không bị nháy -->
  <script is:inline>
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body>
  <a class="hp" href="#main">Bỏ qua điều hướng</a>
  <header class="site">
    <div class="wrap">
      <a class="logo" href="/">devhub</a>
      <nav aria-label="Chính">
        {nav.map(([href, label]) => (
          <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
        ))}
        <button class="theme" id="theme" aria-label="Đổi giao diện sáng/tối">◐</button>
      </nav>
    </div>
  </header>
  <main id="main" class="wrap"><slot /></main>
  <div id="toast" role="status" aria-live="polite"></div>
  <script>
    document.getElementById('theme')?.addEventListener('click', () => {
      const root = document.documentElement;
      const dark = root.dataset.theme === 'dark' ||
        (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
      const next = dark ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  </script>
</body>
</html>
