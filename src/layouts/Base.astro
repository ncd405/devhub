---
import '../styles/global.css';
interface Props { title: string; description?: string; wide?: boolean; }
const { title, description = 'Dự án, blog và công cụ của một lập trình viên.', wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const links = [['/projects/', 'Dự án'], ['/blog/', 'Blog'], ['/tools/', 'Công cụ'], ['/contact/', 'Liên hệ']];
---
<!doctype html>
<html lang="vi" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <!-- Áp dụng theme trước khi vẽ trang để không bị nháy -->
  <script is:inline>
    try { document.documentElement.dataset.theme = localStorage.getItem('theme') || 'dark'; } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Bỏ qua điều hướng</a>
  <header class="site">
    <div class="container bar">
      <a class="logo" href="/"><span class="mark" aria-hidden="true"></span>devhub</a>
      <nav class="desk" aria-label="Chính">
        {links.map(([href, label]) => (
          <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <div class="actions">
        <button class="theme" id="theme" aria-label="Đổi giao diện sáng/tối">◐</button>
        <details class="mob">
          <summary aria-label="Mở menu">☰</summary>
          <div class="panel">
            {[['/', 'Trang chủ'], ...links].map(([href, label]) => (
              <a href={href}>{label}</a>
            ))}
          </div>
        </details>
      </div>
    </div>
  </header>

  <main id="main" class={wide ? 'wide' : 'wrap'}><slot /></main>

  <footer class="site-foot">
    <div class="container foot">
      <div>
        <a class="logo" href="/"><span class="mark" aria-hidden="true"></span>devhub</a>
        <p class="meta">Dự án, blog và công cụ của một lập trình viên.</p>
      </div>
      <div>
        <h3>Trang</h3>
        <ul>{[['/', 'Trang chủ'], ...links].map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
      </div>
      <div>
        <h3>Liên kết</h3>
        <ul>
          <li><a href="https://github.com/ncd405" rel="noopener">GitHub</a></li>
          <li><a href="/sitemap.xml">Sitemap</a></li>
        </ul>
      </div>
    </div>
    <div class="container copy meta">© {new Date().getFullYear()} devhub</div>
  </footer>

  <div id="toast" role="status" aria-live="polite"></div>
  <script>
    document.getElementById('theme')?.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  </script>
</body>
</html>
