---
import '../styles/global.css';
interface Props { title: string; description?: string; wide?: boolean; }
const { title, description = 'Dự án, blog và công cụ của một lập trình viên.', wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const links = [['/projects/', 'Dự án'], ['/blog/', 'Blog'], ['/tools/', 'Công cụ']];
---
<!doctype html>
<html lang="vi" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#1a1b30" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <!-- Áp dụng theme trước khi vẽ trang để không bị nháy -->
  <script is:inline>
    try { document.documentElement.dataset.theme = localStorage.getItem('theme') || 'dark'; } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Bỏ qua điều hướng</a>
  <header class="site">
    <div class="container bar">
      <a class="logo" href="/"><span class="mark" aria-hidden="true"></span>devhub</a>
      <nav class="top" aria-label="Chính">
        {links.map(([href, label]) => (
          <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
    </div>
  </header>

  <main id="main" class={wide ? 'wide' : 'wrap'}><slot /></main>

  <footer class="site-foot">
    <div class="container foot">
      <span class="meta">© {new Date().getFullYear()} devhub</span>
      <ul>
        <li><a href="/contact/">Liên hệ</a></li>
        <li><a href="https://github.com/ncd405" rel="noopener">GitHub</a></li>
        <li><a href="/sitemap.xml">Sitemap</a></li>
        <li><button class="theme" id="theme" type="button" aria-label="Đổi giao diện sáng/tối">Sáng/Tối</button></li>
      </ul>
    </div>
  </footer>

  <div id="toast" role="status" aria-live="polite"></div>
  <script>
    document.getElementById('theme')?.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  </script>
</body>
</html>
