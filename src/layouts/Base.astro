---
import '../styles/global.css';
interface Props { title: string; description?: string; wide?: boolean; }
const { title, description = 'Dự án, blog và công cụ của một lập trình viên.', wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const links = [['/projects/', 'Dự án'], ['/blog/', 'Blog'], ['/tools/', 'Công cụ']];
---
<!doctype html>
<html lang="vi" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <!-- Áp theme và đánh dấu có JS trước khi vẽ trang, tránh nháy -->
  <script is:inline>
    document.documentElement.classList.add('js');
    try { document.documentElement.dataset.theme = localStorage.getItem('theme') || 'light'; } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Bỏ qua điều hướng</a>
  <header class="site" id="site-header">
    <div class="container bar">
      <a class="logo" href="/"><span class="mark" aria-hidden="true"></span>devhub</a>
      <nav class="top" aria-label="Chính">
        {links.map(([href, label]) => (
          <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <div class="actions">
        <a class="btn primary sm" href="/contact/">Liên hệ</a>
        <details class="mob">
          <summary aria-label="Mở menu">☰</summary>
          <div class="panel">
            {[['/', 'Trang chủ'], ...links, ['/contact/', 'Liên hệ']].map(([href, label]) => (
              <a href={href}>{label}</a>
            ))}
          </div>
        </details>
      </div>
    </div>
  </header>

  <main id="main" class={wide ? 'wide' : 'wrap'}><slot /></main>

  <footer class="site-foot">
    <div class="container foot-grid">
      <div>
        <a class="logo" href="/"><span class="mark" aria-hidden="true"></span>devhub</a>
        <p>Dự án, blog và công cụ của một lập trình viên.</p>
      </div>
      <div>
        <h3>Trang</h3>
        <ul>{[['/', 'Trang chủ'], ...links, ['/contact/', 'Liên hệ']].map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
      </div>
      <div>
        <h3>Liên kết</h3>
        <ul>
          <li><a href="https://github.com/ncd405" rel="noopener">GitHub</a></li>
          <li><a href="/sitemap.xml">Sitemap</a></li>
          <li><button class="theme" id="theme" type="button" aria-label="Đổi giao diện sáng/tối">Giao diện sáng/tối</button></li>
        </ul>
      </div>
    </div>
    <div class="container foot-bottom">© {new Date().getFullYear()} devhub</div>
  </footer>

  <div id="toast" role="status" aria-live="polite"></div>
  <script>
    document.getElementById('theme')?.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
    // Thanh trên hiện viền và bóng khi cuộn xuống
    const header = document.getElementById('site-header');
    const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  </script>
</body>
</html>
